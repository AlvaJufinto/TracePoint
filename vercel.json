{
	"version": 2,
	"devCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port $PORT --strictPort",
	"rewrites": [
		{
			"source": "/search",
			"destination": "/index.html"
		},
		{
			"source": "/trace",
			"destination": "/index.html"
		},
		{
			"source": "/investigation",
			"destination": "/index.html"
		}
	]
}
