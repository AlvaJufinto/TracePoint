# Server-only secret used by Vercel Functions. Never prefix it with VITE_.
# Local development: .env.local overrides .env and the process environment.
# Preview/production deployments use the Vercel environment variable only.
SECTORS_API_KEY=

# The app uses api/fixtures/tracepoint-fixtures.json by default.
# Set this to live only when intentionally testing the metered Sectors API.
VITE_DATA_SOURCE=fixtures
